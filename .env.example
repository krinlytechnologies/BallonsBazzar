# Public site configuration (safe to expose to the browser)
NEXT_PUBLIC_SITE_NAME="BalloonBazaar"
NEXT_PUBLIC_SITE_URL="https://balloonbazaar.in"
# No verified public email exists yet — leave unset until confirmed.
# NEXT_PUBLIC_CONTACT_EMAIL="hello@balloonbazaar.in"

# WhatsApp is the primary enquiry channel. International format, digits only,
# no + or spaces (e.g. 919566040112). Unset or malformed, the contact form
# shows a copy-message and call fallback instead of opening WhatsApp.
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# Reserved for future integrations.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- PartyBazaar: Sanity (catalogue content) ---
# Required for /partybazaar and /admin to show real data. Without
# NEXT_PUBLIC_SANITY_PROJECT_ID, both routes render an honest
# "not configured" state instead of fake data.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET="production"
# SANITY_API_VERSION="2026-01-01"
# Only needed if the dataset is private (not required for a public dataset).
# SANITY_API_READ_TOKEN=
# From the Sanity project's API > Webhooks settings — used to verify
# POST /api/revalidate actually came from Sanity.
# SANITY_WEBHOOK_SECRET=

# --- PartyBazaar: Cloudinary (kit image storage) ---
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER="partybazaar-kits"
# Signed upload preset (e.g. balloonbazaar_products). Optional; when set it is
# included in the upload signature.
# CLOUDINARY_UPLOAD_PRESET=

# --- PartyBazaar: Admin authentication ---
# Required for /admin and /api/cloudinary/sign to be reachable at all.
# Without ALL THREE set, /admin shows "not configured" and uploads are
# disabled outright (503) — the app never falls back to an open admin.
# ADMIN_USERNAME=
# Generate with `npm run admin:hash-password` — never store a plain password here.
# ADMIN_PASSWORD_HASH=
# A long random string (e.g. `openssl rand -hex 32`) used to sign session cookies.
# ADMIN_SESSION_SECRET=
